# Listen port (default: 3000)
PORT=3000

# Path to the Codex CLI credentials file (default: ~/.codex/auth.json)
# CODEX_AUTH_PATH=/path/to/auth.json

# Upstream Codex backend root (default: https://chatgpt.com/backend-api/codex)
# CODEX_UPSTREAM=https://chatgpt.com/backend-api/codex

# Upstream usage endpoint served at GET /usage
# CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage

# Version reported in the User-Agent header (default: 0.0.0)
CODEX_CLI_VERSION=0.154.0
